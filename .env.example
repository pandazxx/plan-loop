# litellm model string driving swe_agent's own reasoning, e.g.
# "anthropic/claude-opus-4-8", "openai/gpt-5". Needs the matching provider
# API key below.
PLAN_LOOP_SWE_LLM_MODEL=

# Model id passed to `codex exec -m` for work_llm - NOT a litellm string.
# codex handles its own auth; see https://github.com/openai/codex.
PLAN_LOOP_WORK_LLM_MODEL=

# Provider API keys, per litellm's standard env var names. Only set the
# ones PLAN_LOOP_SWE_LLM_MODEL actually needs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Requires the `codex` CLI (https://github.com/openai/codex) installed and
# authenticated separately - `just doctor` checks for it.

# Set to 1 for verbose logging (Python DEBUG + litellm request/response
# logging) on top of the per-task trajectory files always written to runs/.
PLAN_LOOP_DEBUG=
