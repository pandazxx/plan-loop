# litellm model strings, e.g. "claude-opus-4-8", "gpt-5", "openrouter/..."
# swe-llm and work-llm are intentionally independent so each can be a
# different provider/model.
PLAN_LOOP_SWE_LLM_MODEL=
PLAN_LOOP_WORK_LLM_MODEL=

# Provider API keys, per litellm's standard env var names. Only set the
# ones your chosen models above actually need.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
